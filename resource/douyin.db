-- 10. 创建视图优化查询
-- 用户兴趣标签汇总视图
CREATE VIEW `v_user_interest_summary` AS
SELECT
    ui.user_id,
    u.username,
    COUNT(ui.tag_name) as tag_count,
    AVG(ui.weight) as avg_weight,
    MAX(ui.last_update) as last_interest_update
FROM user_interests ui
JOIN users u ON ui.user_id = u.id
GROUP BY ui.user_id, u.username;

-- 视频标签汇总视图
CREATE VIEW `v_video_tag_summary` AS
SELECT
    vt.video_id,
    v.title,
    COUNT(vt.tag_name) as tag_count,
    AVG(vt.weight) as avg_weight,
    GROUP_CONCAT(vt.tag_name) as tag_list
FROM video_tags vt
JOIN videos v ON vt.video_id = v.id
GROUP BY vt.video_id, v.title;

-- 11. 创建存储过程
DELIMITER //

-- 更新用户兴趣标签权重的存储过程
CREATE PROCEDURE `sp_update_user_interest`(
    IN p_user_id BIGINT,
    IN p_tag_name VARCHAR(50),
    IN p_weight_delta DECIMAL(10,4)
)
BEGIN
    DECLARE v_current_weight DECIMAL(10,4);
    DECLARE v_decay_rate DECIMAL(3,2);

    -- 获取当前权重和衰减率
    SELECT weight, decay_rate INTO v_current_weight, v_decay_rate
    FROM user_interests
    WHERE user_id = p_user_id AND tag_name = p_tag_name;

    IF v_current_weight IS NULL THEN
        -- 创建新的兴趣标签
        INSERT INTO user_interests (user_id, tag_name, weight, last_update, update_count)
        VALUES (p_user_id, p_tag_name, p_weight_delta, NOW(), 1);
    ELSE
        -- 更新现有兴趣标签
        UPDATE user_interests
        SET weight = v_current_weight * v_decay_rate + p_weight_delta,
            last_update = NOW(),
            update_count = update_count + 1
        WHERE user_id = p_user_id AND tag_name = p_tag_name;
    END IF;
END //

-- 计算视频综合评分的存储过程
CREATE PROCEDURE `sp_calculate_video_score`(
    IN p_video_id BIGINT
)
BEGIN
    DECLARE v_hot_score DECIMAL(10,4);
    DECLARE v_quality_score DECIMAL(10,4);
    DECLARE v_relevance_score DECIMAL(10,4);
    DECLARE v_freshness_score DECIMAL(10,4);
    DECLARE v_final_score DECIMAL(10,4);

    -- 计算热度分数（基于观看、点赞、评论、分享）
    SELECT
        (COUNT(DISTINCT wh.user_id) * 0.3 +
         COUNT(DISTINCT CASE WHEN ubl.behavior_type = 'like' THEN ubl.user_id END) * 0.3 +
         COUNT(DISTINCT CASE WHEN ubl.behavior_type = 'comment' THEN ubl.user_id END) * 0.2 +
         COUNT(DISTINCT CASE WHEN ubl.behavior_type = 'share' THEN ubl.user_id END) * 0.2) * 10
    INTO v_hot_score
    FROM videos v
    LEFT JOIN watch_histories wh ON v.id = wh.video_id
    LEFT JOIN user_behavior_logs ubl ON v.id = ubl.video_id
    WHERE v.id = p_video_id;

    -- 计算质量分数（基于完整观看率）
    SELECT
        (COUNT(CASE WHEN wh.is_completed = 1 THEN 1 END) * 1.0 / COUNT(*)) * 100
    INTO v_quality_score
    FROM watch_histories wh
    WHERE wh.video_id = p_video_id;

    -- 计算相关性分数（基于标签匹配度）
    SELECT
        AVG(vt.weight) * 10
    INTO v_relevance_score
    FROM video_tags vt
    WHERE vt.video_id = p_video_id;

    -- 计算新鲜度分数（基于发布时间）
    SELECT
        GREATEST(0, 100 - DATEDIFF(NOW(), v.created_at) * 2)
    INTO v_freshness_score
    FROM videos v
    WHERE v.id = p_video_id;

    -- 计算最终综合分数
    SET v_final_score = v_hot_score * 0.4 + v_quality_score * 0.3 +
                       v_relevance_score * 0.2 + v_freshness_score * 0.1;

    -- 更新或插入视频评分
    INSERT INTO video_scores (video_id, hot_score, quality_score, relevance_score,
                             freshness_score, final_score, last_calculated, score_version)
    VALUES (p_video_id, v_hot_score, v_quality_score, v_relevance_score,
            v_freshness_score, v_final_score, NOW(), 1)
    ON DUPLICATE KEY UPDATE
        hot_score = v_hot_score,
        quality_score = v_quality_score,
        relevance_score = v_relevance_score,
        freshness_score = v_freshness_score,
        final_score = v_final_score,
        last_calculated = NOW(),
        score_version = score_version + 1;
END //

DELIMITER ;

-- 12. 创建触发器
-- 用户观看历史更新后自动更新用户画像
DELIMITER //
CREATE TRIGGER `tr_watch_history_after_insert`
AFTER INSERT ON `watch_histories`
FOR EACH ROW
BEGIN
    UPDATE user_profiles
    SET total_watch = total_watch + NEW.watch_duration,
        last_active_at = NOW(),
        avg_watch_duration = (total_watch + NEW.watch_duration) /
                           (SELECT COUNT(*) FROM watch_histories WHERE user_id = NEW.user_id)
    WHERE user_id = NEW.user_id;
END //

-- 用户行为日志更新后自动更新用户画像
CREATE TRIGGER `tr_behavior_log_after_insert`
AFTER INSERT ON `user_behavior_logs`
FOR EACH ROW
BEGIN
    CASE NEW.behavior_type
        WHEN 'like' THEN
            UPDATE user_profiles
            SET total_likes = total_likes + 1,
                last_active_at = NOW()
            WHERE user_id = NEW.user_id;
        WHEN 'comment' THEN
            UPDATE user_profiles
            SET total_comments = total_comments + 1,
                last_active_at = NOW()
            WHERE user_id = NEW.user_id;
        WHEN 'share' THEN
            UPDATE user_profiles
            SET total_shares = total_shares + 1,
                last_active_at = NOW()
            WHERE user_id = NEW.user_id;
        WHEN 'favorite' THEN
            UPDATE user_profiles
            SET total_favorites = total_favorites + 1,
                last_active_at = NOW()
            WHERE user_id = NEW.user_id;
    END CASE;
END //
DELIMITER ;

