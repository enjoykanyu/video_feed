CREATE TABLE `users` (  用户作者表
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '用户ID',
  `username` VARCHAR(32) NOT NULL COMMENT '用户名',
  `password` VARCHAR(255) NOT NULL COMMENT '加密密码',
  `mobile` VARCHAR(20) UNIQUE COMMENT '手机号',
  `email` VARCHAR(100) UNIQUE COMMENT '邮箱',
  `avatar_url` VARCHAR(255) COMMENT '头像URL',
  `signature` VARCHAR(255) COMMENT '个性签名',
  `gender` TINYINT DEFAULT 0 COMMENT '性别(0-未知 1-男 2-女)',
  `birthday` DATE COMMENT '生日',
  `is_creator` BOOLEAN DEFAULT FALSE COMMENT '是否创作者',
  `creator_info` JSON COMMENT '创作者扩展信息',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE INDEX `idx_username` (`username`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `videos` ( 视频内容表
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  `author_id` BIGINT UNSIGNED NOT NULL COMMENT '作者ID',
  `title` VARCHAR(100) NOT NULL COMMENT '视频标题',
  `play_url` VARCHAR(255) NOT NULL COMMENT '播放地址',
  `cover_url` VARCHAR(255) NOT NULL COMMENT '封面地址',
  `favorite_count` INT UNSIGNED DEFAULT 0 COMMENT '点赞数',
  `comment_count` INT UNSIGNED DEFAULT 0 COMMENT '评论数',
  `duration` INT UNSIGNED COMMENT '视频时长(秒)',
  `resolution` VARCHAR(20) COMMENT '分辨率',
  `tags` JSON COMMENT '视频标签',
  `status` TINYINT DEFAULT 1 COMMENT '状态(0-下架 1-正常)',
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  INDEX `idx_author` (`author_id`),
  INDEX `idx_hot` (`favorite_count`, `comment_count`),
  FULLTEXT INDEX `ft_title` (`title`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- 抖音推荐系统优化表结构
-- 说明: 基于用户行为分析的推荐系统数据表

-- 1. 用户兴趣标签表
CREATE TABLE `user_interests` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `user_id` BIGINT UNSIGNED NOT NULL COMMENT '用户ID',
  `tag_name` VARCHAR(50) NOT NULL COMMENT '标签名称',
  `weight` DECIMAL(10,4) NOT NULL DEFAULT 0.0000 COMMENT '兴趣权重(0-100)',
  `decay_rate` DECIMAL(3,2) NOT NULL DEFAULT 0.90 COMMENT '衰减率(0.8-0.99)',
  `last_update` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '最后更新时间',
  `update_count` INT NOT NULL DEFAULT 0 COMMENT '更新次数',
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_user_tag` (`user_id`, `tag_name`),
  KEY `idx_user_id` (`user_id`),
  KEY `idx_tag_name` (`tag_name`),
  KEY `idx_last_update` (`last_update`),
  KEY `idx_weight` (`weight`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户兴趣标签表';

-- 2. 用户观看历史表
CREATE TABLE `watch_histories` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `user_id` BIGINT UNSIGNED NOT NULL COMMENT '用户ID',
  `video_id` BIGINT UNSIGNED NOT NULL COMMENT '视频ID',
  `watch_duration` INT NOT NULL COMMENT '观看时长(秒)',
  `watch_progress` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT '观看进度百分比',
  `is_completed` BOOLEAN NOT NULL DEFAULT FALSE COMMENT '是否完整观看',
  `device_type` VARCHAR(20) COMMENT '设备类型(mobile/web/app)',
  `ip_address` VARCHAR(45) COMMENT 'IP地址',
  `user_agent` VARCHAR(500) COMMENT '用户代理',
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  PRIMARY KEY (`id`),
  KEY `idx_user_video` (`user_id`, `video_id`),
  KEY `idx_user_time` (`user_id`, `created_at`),
  KEY `idx_video_time` (`video_id`, `created_at`),
  KEY `idx_created_at` (`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户观看历史表';

-- 3. 视频标签表
CREATE TABLE `video_tags` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `video_id` BIGINT UNSIGNED NOT NULL COMMENT '视频ID',
  `tag_name` VARCHAR(50) NOT NULL COMMENT '标签名称',
  `weight` DECIMAL(10,4) NOT NULL DEFAULT 1.0000 COMMENT '标签权重(0-100)',
  `tag_type` VARCHAR(20) NOT NULL DEFAULT 'content' COMMENT '标签类型(content/category/emotion)',
  `confidence` DECIMAL(5,2) NOT NULL DEFAULT 1.00 COMMENT '置信度(0-1)',
  `source` VARCHAR(20) NOT NULL DEFAULT 'manual' COMMENT '标签来源(manual/ai/auto)',
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`),
  KEY `idx_video_tag` (`video_id`, `tag_name`),
  KEY `idx_tag_name` (`tag_name`),
  KEY `idx_tag_type` (`tag_type`),
  KEY `idx_source` (`source`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='视频标签表';

-- 4. 用户画像表
CREATE TABLE `user_profiles` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `user_id` BIGINT UNSIGNED NOT NULL COMMENT '用户ID',
  `last_active_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '最后活跃时间',
  `total_watch` BIGINT NOT NULL DEFAULT 0 COMMENT '总观看时长(秒)',
  `total_likes` BIGINT NOT NULL DEFAULT 0 COMMENT '总点赞数',
  `total_comments` BIGINT NOT NULL DEFAULT 0 COMMENT '总评论数',
  `total_shares` BIGINT NOT NULL DEFAULT 0 COMMENT '总分享数',
  `total_favorites` BIGINT NOT NULL DEFAULT 0 COMMENT '总收藏数',
  `avg_watch_duration` DECIMAL(8,2) NOT NULL DEFAULT 0.00 COMMENT '平均观看时长(秒)',
  `watch_frequency` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT '观看频率(次/天)',
  `preference_score` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT '偏好得分(0-100)',
  `engagement_level` VARCHAR(20) NOT NULL DEFAULT 'low' COMMENT '参与度等级(low/medium/high)',
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_user_id` (`user_id`),
  KEY `idx_last_active` (`last_active_at`),
  KEY `idx_engagement` (`engagement_level`),
  KEY `idx_preference` (`preference_score`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户画像表';

-- 5. 视频评分表
CREATE TABLE `video_scores` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `video_id` BIGINT UNSIGNED NOT NULL COMMENT '视频ID',
  `hot_score` DECIMAL(10,4) NOT NULL DEFAULT 0.0000 COMMENT '热度分数(0-100)',
  `quality_score` DECIMAL(10,4) NOT NULL DEFAULT 0.0000 COMMENT '质量分数(0-100)',
  `relevance_score` DECIMAL(10,4) NOT NULL DEFAULT 0.0000 COMMENT '相关性分数(0-100)',
  `freshness_score` DECIMAL(10,4) NOT NULL DEFAULT 0.0000 COMMENT '新鲜度分数(0-100)',
  `final_score` DECIMAL(10,4) NOT NULL DEFAULT 0.0000 COMMENT '最终综合分数(0-100)',
  `score_version` INT NOT NULL DEFAULT 1 COMMENT '评分版本',
  `last_calculated` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '最后计算时间',
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_video_id` (`video_id`),
  KEY `idx_final_score` (`final_score`),
  KEY `idx_hot_score` (`hot_score`),
  KEY `idx_last_calculated` (`last_calculated`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='视频评分表';

-- 6. 用户行为日志表
CREATE TABLE `user_behavior_logs` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `user_id` BIGINT UNSIGNED NOT NULL COMMENT '用户ID',
  `video_id` BIGINT UNSIGNED NOT NULL COMMENT '视频ID',
  `behavior_type` VARCHAR(20) NOT NULL COMMENT '行为类型(watch/like/comment/share/favorite)',
  `duration` INT NOT NULL DEFAULT 0 COMMENT '行为持续时间(秒)',
  `intensity` DECIMAL(5,2) NOT NULL DEFAULT 1.00 COMMENT '行为强度(0-10)',
  `context` VARCHAR(100) COMMENT '行为上下文(feed/search/profile)',
  `device_info` VARCHAR(200) COMMENT '设备信息',
  `location` VARCHAR(100) COMMENT '地理位置',
  `session_id` VARCHAR(64) COMMENT '会话ID',
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  PRIMARY KEY (`id`),
  KEY `idx_user_time` (`user_id`, `created_at`),
  KEY `idx_video_time` (`video_id`, `created_at`),
  KEY `idx_behavior_type` (`behavior_type`),
  KEY `idx_created_at` (`created_at`),
  KEY `idx_session` (`session_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户行为日志表';

-- 7. 标签相似度表
CREATE TABLE `tag_similarities` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `tag_name1` VARCHAR(50) NOT NULL COMMENT '标签1',
  `tag_name2` VARCHAR(50) NOT NULL COMMENT '标签2',
  `similarity` DECIMAL(5,4) NOT NULL DEFAULT 0.0000 COMMENT '相似度(0-1)',
  `correlation` DECIMAL(5,4) NOT NULL DEFAULT 0.0000 COMMENT '相关性(0-1)',
  `cooccurrence` BIGINT NOT NULL DEFAULT 0 COMMENT '共现次数',
  `last_updated` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '最后更新时间',
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_tag_pair` (`tag_name1`, `tag_name2`),
  KEY `idx_tag1` (`tag_name1`),
  KEY `idx_tag2` (`tag_name2`),
  KEY `idx_similarity` (`similarity`),
  KEY `idx_last_updated` (`last_updated`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='标签相似度表';

-- 8. 创建索引优化
-- 复合索引优化查询性能
CREATE INDEX `idx_user_behavior_time` ON `user_behavior_logs` (`user_id`, `behavior_type`, `created_at`);
CREATE INDEX `idx_video_score_time` ON `video_scores` (`final_score`, `last_calculated`);
CREATE INDEX `idx_user_profile_stats` ON `user_profiles` (`total_watch`, `total_likes`, `engagement_level`);

